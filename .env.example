# ==============================================================================
# NodiGuard Community Edition - Environment Configuration Template
# ZERO-LEAK GUARANTEE: Never commit production API keys or credentials to Git!
# ==============================================================================

# Local Proxy Configuration
NODIGUARD_HOST=127.0.0.1
NODIGUARD_PORT=8080
NODIGUARD_LOG_LEVEL=INFO

# Upstream LLM Gateway Configuration
# Point this to your target LLM provider (OpenAI, Claude proxy, Groq, DeepSeek, or local Ollama)
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-your-upstream-api-key-here

# Local SLM & System Optimizer Settings
# Default Ollama host for local GPU VRAM purging upon task completion
OLLAMA_HOST=http://127.0.0.1:11434
AUTO_OPTIMIZE_RAM=true
AUTO_PURGE_VRAM=true
IDLE_TIMEOUT_SECONDS=30

# Security & DLP Policy
BLOCK_ON_SECRET_LEAK=true
ENABLE_PROMPT_ANONYMIZATION=true
ENABLE_ADVERSARIAL_DEFENSE=true
